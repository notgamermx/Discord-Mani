{
  "manifest_version": 3,
  "name": "Morrow — Make Discord yours",
  "version": "0.4.1",
  "description": "A little more you. Themes, colors, layout controls, and custom CSS for Discord in your browser.",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": {"16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png"},
  "action": {"default_popup": "popup.html", "default_title": "Morrow", "default_icon": "icons/icon-32.png"},
  "options_ui": {"page": "options.html", "open_in_tab": true},
  "content_scripts": [{
    "matches": ["https://discord.com/*", "https://ptb.discord.com/*", "https://canary.discord.com/*"],
    "js": ["src/engine.js", "src/video.js", "src/content.js"],
    "run_at": "document_start"
  }],
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
